# OppHub Environment Variables
# Copy to .env.local for local development

# 1. Supabase (Free Tier: https://supabase.com)
# Client-side variables (used by browser for auth/realtime):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-side variables (used by Next.js API routes & background ingestion scripts):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# 2. Telegram Bot Notifications
# Telegram Bot Token and Chat ID are configured in the OppHub UI at /settings
# and stored securely in the Supabase 'settings' table.
# DO NOT add TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID to this file.

# 3. AI / LLM Provider for Resume Tailoring & JD Matching (Free Tier)
# Supported providers: "gemini" (default) or "groq"
AI_PROVIDER=gemini
# LLM_PROVIDER=gemini

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-gemini-api-key

# Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key

# 4. GitHub Token (Optional for higher rate limits on Good First Issue Search API)
# In GitHub Actions CI, GITHUB_TOKEN is automatically provided.
# For local ingestion or higher 30 req/min search rate limits, supply a Personal Access Token (classic or fine-grained):
GH_PAT=your-github-personal-access-token
# GITHUB_TOKEN=your-github-token
