# OppHub Environment Variables
# Copy to .env.local for local development

# 1. Supabase (Free Tier: https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 2. Telegram Bot Notifications (Managed in Settings UI & saved to Supabase settings table)
# (Optionally configured via @BotFather and OppHub /settings page)

# 3. AI / LLM Provider for Resume Tailoring & JD Matching (Free Tier)
# Supported providers: "gemini" (default) or "groq" (via AI_PROVIDER or LLM_PROVIDER)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# 4. GitHub Token (Optional for higher rate limits on Good First Issue Search)
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token
